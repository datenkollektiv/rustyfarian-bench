# {{ ansible_managed }} — deploy/ansible/roles/bench/templates/rustyfarian-bench.service.j2
[Unit]
Description=rustyfarian-bench remote bench (serve)
Documentation=https://github.com/datenkollektiv/rustyfarian-bench/tree/main/deploy
Wants=network-online.target
After=network-online.target time-sync.target
# a bad token file ends serve at start; stop retrying instead of looping forever
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=exec
User=bench
Group=bench
SupplementaryGroups=dialout
Environment=HOME={{ bench_home }}
ExecStart=/usr/local/bin/rustyfarian-bench serve \
    --host 0.0.0.0 --port {{ bench_port }} \
    --outbox {{ bench_outbox }} \
    --job-timeout {{ bench_job_timeout }} --detect-timeout {{ bench_detect_timeout }} \
    --token-file {{ bench_etc }}/tokens.toml \
    --ssl-certfile {{ bench_etc }}/cert.pem --ssl-keyfile {{ bench_etc }}/key.pem
# SIGTERM to serve only: it ends a running job's process group itself, then systemd kills leftovers
KillMode=mixed
TimeoutStopSec=30
Restart=on-failure
RestartSec=5

# serve writes only its outbox; boards re-enumerate, so /dev stays visible (no PrivateDevices)
ProtectSystem=strict
ReadWritePaths={{ bench_home }}
ProtectHome=yes
PrivateTmp=yes
NoNewPrivileges=yes
UMask=0077
CapabilityBoundingSet=
AmbientCapabilities=
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictNamespaces=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
LockPersonality=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target
